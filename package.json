    "test:php": "php tests/plugin-check.php \"${WP_DIR:-/tmp/moveon-wp/wp}\""
  },
  "devDependencies": {
    "@fontsource/montserrat": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  }
}
