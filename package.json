{
  "name": "moveon-sito",
  "version": "1.0.0",
  "private": true,
  "description": "Plugin WordPress MoveOn Blocks (WPBakery) per il sito di MoveOn Studio",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "zip": "python3 tools/build-zip.py",
    "wp:prova": "bash tools/wp-prova.sh",
